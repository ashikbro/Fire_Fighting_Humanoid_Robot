# Example .env file for Fire Fighting Humanoid Robot Project
# Copy this file to .env and edit values as needed

# Flask/Django/Other API settings
API_HOST=127.0.0.1
API_PORT=5000
DEBUG=True

# Database settings
DB_PATH=fire_data_bangladesh_1000000.csv

# MQTT settings
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=fire/alerts

# Model paths
FIRE_MODEL_PATH=vision_fire_detection/models/fire_detection_cnn.h5
SEVERITY_MODEL_PATH=vision_fire_detection/models/fire_severity_model_DeepLearning.h5

# Other settings
SKIP_DATASET_DOWNLOAD=0

# API users file (NOT committed). Create users with:
#   python -m src.auth add <username> <admin|operator|viewer>
USERS_FILE=users.txt

# Alert e-mail account (use an app password, never your main password)
ALERT_SENDER_EMAIL=
ALERT_SENDER_PASSWORD=
ALERT_RECEIVER_EMAIL=
